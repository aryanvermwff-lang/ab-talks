# ==============================================================================
# ABTalks 60-Day Coding Challenge — AI Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and paste your API key below:
# In Vite, client-side variables must start with VITE_
# ==============================================================================

# Option 1: Google Gemini API Key (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Option 2: OpenAI API Key (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=

# Option 3: Groq Cloud API Key (https://console.groq.com/keys)
# or OpenRouter API Key (https://openrouter.ai/keys)
VITE_AI_API_KEY=
